# Веб-сервер
WEB_HOST=0.0.0.0
WEB_PORT=8765
# Опциональный bearer-токен. Если выставлен — обязателен в Authorization: Bearer <token>
# WEB_ADMIN_TOKEN=secret123

# S3 зеркалирование результатов
# UI подставляет значения из env, если они есть.
# S3_BUCKET=
# S3_PREFIX=test/runner/
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=                       # для R2/MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
